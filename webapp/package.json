{
    "name": "q-pilot-chat",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "bash ./env-config.sh && vite",
        "format": "prettier src --check",
        "format:fix": "prettier src --write",
        "lint": "eslint src --max-warnings=0",
        "lint:fix": "eslint src --fix",
        "serve": "bash ./env-config.sh && serve -s build",
        "start": "bash ./env-config.sh && vite",
        "build": "vite build",
        "test": "playwright test"
    },
    "dependencies": {
        "@azure/msal-browser": "^3.28.1",
        "@azure/msal-react": "^2.2.0",
        "@fluentui/react-components": "^9.58.1",
        "@fluentui/react-datepicker-compat": "^0.4.62",
        "@fluentui/react-icons": "^2.0.249",
        "@mdxeditor/editor": "^3.21.1",
        "@microsoft/microsoft-graph-client": "^3.0.7",
        "@microsoft/signalr": "^8.0.7",
        "@playwright/test": "^1.50.0",
        "@reduxjs/toolkit": "^2.5.1",
        "@vitejs/plugin-react": "^4.3.4",
        "browserslist-to-esbuild": "^2.1.1",
        "debug": "^4.4.0",
        "jwt-decode": "^4.0.0",
        "microsoft-cognitiveservices-speech-sdk": "^1.42.0",
        "react": "^18.3.1",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^9.0.3",
        "react-multi-carousel": "2.8.5",
        "react-redux": "^9.2.0",
        "rehype-mathjax": "^6.0.0",
        "remark-gfm": "^4.0.0",
        "remark-math": "^6.0.0",
        "remark-supersub": "^1.0.0",
        "uuid": "^11.0.5",
        "vite": "^6.0.11",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "@types/debug": "^4.1.12",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.4.2",
        "serve": "^14.2.4",
        "ts-jest": "^29.2.5",
        "typescript": "5.5.3"
    },
    "jest": {
        "preset": "ts-jest/presets/js-with-ts",
        "testEnvironment": "jest-environment-jsdom",
        "moduleNameMapper": {
            "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
            "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
        },
        "modulePaths": [
            "<rootDir>/src"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 edge version",
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "packageManager": "yarn@1.22.19"
}
